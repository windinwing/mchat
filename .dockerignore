# Backend images use the repository root so they can copy both src/backend and skills.
# Keep the context allowlisted to avoid sending local environments, tenant data,
# uploads, browser profiles, and frontend dependencies to the Docker daemon.
**
!src/
src/**
!src/backend/
src/backend/**
!src/backend/app/
!src/backend/app/**
!src/backend/requirements.txt
!src/backend/requirements-lite.txt
!src/backend/.env.example
!src/backend/Dockerfile
!src/backend/Dockerfile.lite
!skills/
skills/**
!skills/.gitkeep
!skills/mchat-help/
skills/mchat-help/**
!skills/mchat-help/SKILL.md
!skills/mchat-ops/
skills/mchat-ops/**
!skills/mchat-ops/SKILL.md
!skills/mchat-ops/main.py
!skills/mchat-notify/
skills/mchat-notify/**
!skills/mchat-notify/SKILL.md
!skills/mchat-notify/main.py
!skills/mchat-notify/providers/
skills/mchat-notify/providers/**
!skills/mchat-notify/providers/README.md
!skills/gamecenter-dev-agent/
skills/gamecenter-dev-agent/**
!skills/gamecenter-dev-agent/SKILL.md
!skills/dev-assistant/
skills/dev-assistant/**
!skills/dev-assistant/SKILL.md
!skills/git-commit-writer/
skills/git-commit-writer/**
!skills/git-commit-writer/SKILL.md
!skills/code-reviewer/
skills/code-reviewer/**
!skills/code-reviewer/SKILL.md
!skills/patent-search/
skills/patent-search/**
!skills/patent-search/patent_api.py
!skills/patent-search/query_utils.py
**/__pycache__/
**/*.py[cod]
**/.DS_Store
