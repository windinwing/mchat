[Unit]
Description=mchat DevBridge build worker pool (GameCenter compile queue, default 5 slots)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/xiaoxiao/mchat/src/backend
EnvironmentFile=/opt/xiaoxiao/mchat/.env
ExecStart=/opt/xiaoxiao/mchat/src/backend/venv/bin/python /opt/xiaoxiao/mchat/ops/scripts/gamecenter-build-worker.py
# `always` (not `on-failure`) so the worker is restarted even when killed by a
# signal during a deploy (SIGTERM is not a "failure", so on-failure would leave
# it dead — which is exactly what happened and stalled all builds).
Restart=always
RestartSec=5
# Guard against a crash loop: at most 5 restarts per 60s, then stop. systemd
# clears this counter after running steadily for StartLimitIntervalSec.
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=default.target
