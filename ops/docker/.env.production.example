# Production environment - copy to .env.production before deploy
# cp ops/docker/.env.production.example ops/docker/.env.production

MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=mchat
MYSQL_USER=mchat
MYSQL_PASSWORD=mchat_password_change_me

JWT_SECRET=change-me-to-a-random-secret-key-at-least-32-chars
JWT_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_change_me
ENVIRONMENT=production
SHOW_BOOTSTRAP_CREDENTIALS=false

BACKEND_PORT=3001
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:3001

MILVUS_ENABLED=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mchat-uploads
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
