# Append to 10.98.8.15 /opt/xiaoxiao/mchat/.env (GameCenter auto-build)
#
# NOTE: 10.98.8.15 runs the CLOUD edition (cloud.main:app, mchat-cloud-backend.service).
#   Deploy with:  make deploy-cloud MCHAT_DEPLOY_REMOTE=user@10.98.8.15
#   The frontend login UI now reads edition flags from the backend at runtime
#   (/auth/bootstrap), so register/phone/9235 SSO show correctly even if the
#   frontend was accidentally built as Core — but always prefer deploy-cloud.

# Mac mini Cocos build machine (current default)
GAMECENTER_BUILD_SSH_HOST=10.98.8.188
GAMECENTER_BUILD_SSH_USER=shuxue0916
GAMECENTER_BUILD_PIPELINE_SCRIPT=/Users/shuxue0916/dev/mchat/ops/scripts/gamecenter-local-pipeline.sh
GAMECENTER_DEPLOY_HOST=10.98.8.15

# Windows HTTP agent (legacy 10.98.8.186) — only for Cocos 2.x if still on Windows.
# Leave unset when all builds go through the Mac mini via SSH.
# GAMECENTER_BUILD_AGENT_URL=http://10.98.8.186:19280
# GAMECENTER_BUILD_AGENT_TOKEN=与_windows_agent.json_里_token_一致

MCHAT_SIGNUP_ENABLED=true
GAMECENTER_AUTO_BUILD_AFTER_PATCH=true
GAMECENTER_BUILD_COMMAND=bash /opt/xiaoxiao/mchat/ops/scripts/gamecenter-remote-pipeline-build.sh {slug} {build_id}

# After editing .env, restart the build worker:
#   systemctl --user restart mchat-build-worker.service
