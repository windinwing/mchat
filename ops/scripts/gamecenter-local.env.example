# Copy to gamecenter-local.env and adjust paths on your Mac / Mac mini.
export GAMECENTER_COCOS_CREATOR_BIN="/Applications/Cocos/Creator/3.8.8/CocosCreator.app/Contents/MacOS/CocosCreator"
export GAMECENTER_COCOS_3_VERSION="3.8.8"
export GAMECENTER_COCOS_2_VERSION="2.4.15"
export GAMECENTER_COCOS_3_BIN="/Applications/Cocos/Creator/3.8.8/CocosCreator.app/Contents/MacOS/CocosCreator"
export GAMECENTER_COCOS_2_BIN="/Applications/Cocos/Creator/2.4.15/CocosCreator.app/Contents/MacOS/CocosCreator"
export LOCAL_GAMECENTER="$HOME/dev/gamecenter-server"
export GAMECENTER_WORKSPACE="/Users/$USER/dev/xcx"
export SSH_USER="xiaoxiao"
# export REMOTE_GAMECENTER_ROOT="/opt/xiaoxiao/gamecenter"
# export REMOTE_PROJECT_PARENT="src"
# export REMOTE_MCHAT="/opt/xiaoxiao/mchat"
# export REMOTE_PLAYABLES_ROOT="/opt/xiaoxiao/gamecenter/playables"

# Full guide: docs/gamecenter-local-build-guide.zh.md
# One-shot: ./ops/scripts/gamecenter-local-pipeline.sh 10.98.8.15 <slug> --force
# Diff check: ./ops/scripts/gamecenter-diff-server-local.sh 10.98.8.15 <slug>
